<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuração criptográfica do Secure Proxy (formato da secção 2.2.2 do enunciado,
  com as gralhas corrigidas). Tem de ser compatível com sservercrypto.config.

  Combinações suportadas:
    AES      / GCM      / NoPadding    + MAC NULL                 (AEAD)
    ChaCha20 / Poly1305 / NoPadding    + MAC NULL                 (AEAD)
    AES      / CTR      / NoPadding    + HMAC-SHA256/384/512      (encrypt-then-MAC)
    AES      / CBC      / PKCS5Padding + HMAC-SHA256/384/512      (encrypt-then-MAC)
    ChaCha20 / NULL     / NoPadding    + HMAC-SHA256/384/512      (encrypt-then-MAC)

  Chaves e IV em hexadecimal ou Base64.
  A SKey (e a MacKey, se existir) é usada como chave pré-partilhada para autenticar
  o Diffie-Hellman; as chaves de sessão são sempre derivadas de novo (HKDF).
  O IV também só entra na derivação: nunca é usado diretamente como nonce.
-->
<ProxyCryptoConfig version="1.0">
    <SymCipherSuite>
        <Algorithm>AES</Algorithm>
        <Mode>GCM</Mode>
        <InitializationVector>
            <IV>6e93c744d1613e3026a3f0bc</IV>
            <IVSize>96</IVSize>
        </InitializationVector>
        <Padding>NoPadding</Padding>
    </SymCipherSuite>
    <MACSuite>
        <Algorithm>NULL</Algorithm>
    </MACSuite>
    <ConfiguredKeys>
        <SymmetricKey>
            <SKey>1b61857bd228a4803959e9bd9ecc5317840183b1925679bfa1fa3fbf7c70aace</SKey>
            <Keysize>256</Keysize>
        </SymmetricKey>
        <MACKey>
            <MacKey>NULL</MacKey>
            <MacKeySize>NULL</MacKeySize>
        </MACKey>
    </ConfiguredKeys>
</ProxyCryptoConfig>
